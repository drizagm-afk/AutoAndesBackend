            "method": "GET",
            "header": [],
            "url": "{{baseUrl}}/clientes"
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"HTTP 200\", () => pm.response.to.have.status(200));",
                  "const rows = pm.response.json();",
                  "pm.test(\"Al menos 6 clientes\", () => pm.expect(rows.length).to.be.at.least(6));",
                  "pm.environment.set(\"clienteId\", rows[0].id);"
